# Copy to /tmp/setup.env and edit locally. This file is sourced by /bin/sh.
# Use only simple trusted KEY='value' assignments.

WG_IF='wg0'
AWG_IF='awg0'

# Existing OpenWrt logical interface and its firewall zone.
TRANSPORT_IF='wan'
TRANSPORT_ZONE='wan'
TRANSPORT_METRIC='100'
LAN_ZONE='lan'

WG_CONF='/tmp/wireguard.conf'
AWG_CONF='/tmp/amneziawg.conf'
WG_MTU='1420'
AWG_MTU='1420'

INITIAL_MODE='wg'
PROBE_IP='1.1.1.1'
ENABLE_IPV6='0'

# DNS is intentionally explicit and must be reachable through both tunnels.
DNS_SERVERS='1.1.1.1 9.9.9.9'

# Permit downstream LAN clients to contact literal IPv4 VPN endpoints directly.
ALLOW_DOWNSTREAM_ENDPOINTS='1'

# Optional remote SSH to the router through both VPNs.
ALLOW_REMOTE_SSH='0'
WG_ADMIN_CIDR='10.10.1.0/24'
AWG_ADMIN_CIDR='10.10.2.0/24'

# Optional executable hook before VPN preflight, for custom time/modem readiness.
PRE_VPN_HOOK=''

# Optional LTE modem clock. Enable only after confirming AT+CCLK is UTC.
MODEM_AT_PORT=''
MODEM_CLOCK_IS_UTC='0'
